# OpenClaw & Google AX Environment Configuration Example
# Copy this file to .env or export these in your shell

# Telegram Bot API Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# LLM Inference Endpoint & Credentials
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Google AX Server (auto-configured in-cluster or via port-forward)
AX_SERVER=http://ax-server.ax-system.svc.cluster.local:8080
SYNC_INTERVAL=15
